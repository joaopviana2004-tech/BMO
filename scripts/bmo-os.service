[Unit]
Description=BMO OS
# Conecta o alto-falante Bluetooth antes (se o servico existir; Wants e fraco,
# entao o BMO sobe mesmo que essa conexao falhe).
Wants=bmo-bt-speaker.service
After=bmo-bt-speaker.service

[Service]
Type=simple
# %h = home do usuario. Assume o repo em ~/BMO e o venv em ~/BMO/.venv
# (o instalador bmo-os-install.sh gera uma versao com os caminhos REAIS).
WorkingDirectory=%h/BMO
Environment=SDL_VIDEODRIVER=kmsdrm
ExecStart=%h/BMO/.venv/bin/python -m bmo_os.main --fullscreen
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
