*.cache

# Config local do BMO OS — guarda preferências e token do Todoist, nunca commitar
bmo_config.json

# Estado emocional e memória do pet (afeto, streak, fatos do usuário) — local
bmo_pet.json
bmo_memory.json

# Melhor cérebro do treino de Flappy (neuroevolução) — modelo treinado local
flappy_ai.json

# Campeão do treino de Haxball (neuroevolução) — modelo treinado local
haxball_ai.json
# Imitador supervisionado do heurístico (semente do treino) — cache local recomputável
haxball_imitator.json

# Tokens OAuth do Google Calendar (refresh tokens) — NUNCA commitar
gcal_tokens.json

# Perfis de usuário (tokens OAuth, preferências, sessão ativa) — NUNCA commitar
profiles/

# Token do sync de conhecimento do PC (scripts/bimo_pc_sync.py) — NUNCA commitar
bimo_pc_tokens.json

# Gravações offline-first aguardando sync (modo legado/sem sessão)
recordings/

# Espelho local das notas do Segundo Cérebro (modo legado/sem sessão)
knowledge/

